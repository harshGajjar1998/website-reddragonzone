# Redragon CMS API the site is built from (reddragon-cms/backend).
# Pages fetch all content from <CMS_API_URL>/api/public/bundle at build time; the build fails if it can't be reached.
# Production: set this in Netlify (Site settings → Environment variables), and add a Netlify build hook
# to the CMS's CMS_PUBLISH_WEBHOOKS so publishing in the CMS rebuilds the site.
CMS_API_URL=http://127.0.0.1:8010

# Draft preview for the CMS visual editor (`npm run preview:cms`, port 3002). Only that server uses these.
# CMS_PREVIEW_KEY must equal CMS_PREVIEW_KEY in reddragon-cms/backend/.env.
CMS_PREVIEW_KEY=
# Admin origin allowed to talk to the preview page
CMS_ADMIN_ORIGIN=http://localhost:5174
