# Hostinger (LiteSpeed) – the static export from `next build` (Netlify ignores this file and uses _redirects)
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Same as public/_redirects
    RewriteRule ^support/download/?$ /support/ [R=302,L]
    RewriteRule ^news/?$ /blog/ [R=302,L]
    RewriteRule ^where-to-buy/.+ /where-to-buy/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HTTPS only from now on (Hostinger renews the certificate automatically)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Inline scripts/styles: Next's static export and the desktop-zoom snippet in layout.tsx.
    # Images and forms reach the CMS on its own domain (https:).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
    # Pages change on every CMS publish: always re-check them
    <FilesMatch "\.(html|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
